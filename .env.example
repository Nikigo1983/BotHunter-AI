# Application
APP_NAME=BotHunter AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1

# Database
# Either set DATABASE_URL (Railway/Neon) or individual POSTGRES_* variables.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bothunter
POSTGRES_PASSWORD=bothunter
POSTGRES_DB=bothunter
POSTGRES_SSL=false

# Redis
# Local Docker: REDIS_HOST/REDIS_PORT. Upstash/Railway: use REDIS_URL (rediss://...).
# REDIS_URL=rediss://default:password@endpoint.upstash.io:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Telegram Bot
BOT_TOKEN=your-telegram-bot-token

# AI Layer
AI_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1
AI_TIMEOUT=30
AI_MAX_RETRIES=2

# Legacy OpenAI settings (optional, provider=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

# Decision Engine thresholds (optional overrides for decision_thresholds.yaml)
DECISION_APPROVE_BELOW=30
DECISION_REJECT_FROM=70

# Dashboard auth (v2.0)
DASHBOARD_SESSION_SECRET=change-me-in-production
DASHBOARD_SESSION_MAX_AGE_HOURS=24
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_HTTPS_ENABLED=false
DASHBOARD_ADMIN_EMAIL=admin@bothunter.local
DASHBOARD_ADMIN_PASSWORD=admin
MONTHLY_BUDGET_USD=100

# Dashboard seed users (scripts/seed_dashboard_users.py)
DASHBOARD_USER_VERONIKA_PASSWORD=
DASHBOARD_USER_ZLATA_PASSWORD=
DASHBOARD_USER_JULIA_PASSWORD=
