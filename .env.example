# Application
APP_NAME=BotHunter AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bothunter
POSTGRES_PASSWORD=bothunter
POSTGRES_DB=bothunter

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Telegram Bot
BOT_TOKEN=your-telegram-bot-token

# AI Layer
AI_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1
AI_TIMEOUT=30
AI_MAX_RETRIES=2

# Legacy OpenAI settings (optional, provider=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

# Decision Engine thresholds (optional overrides for decision_thresholds.yaml)
DECISION_APPROVE_BELOW=30
DECISION_REJECT_FROM=70
